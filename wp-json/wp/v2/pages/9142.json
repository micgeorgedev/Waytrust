xed elementor-section-height-default elementor-section-height-default row-top\" data-eae-slider=\"31240\" data-id=\"45160c1\" data-element_type=\"section\" data-e-type=\"section\">\n\t\t\t\t\t\t<div class=\"elementor-container elementor-column-gap-default\">\n\t\t\t\t\t<div class=\"has_eae_slider elementor-column elementor-col-100 elementor-inner-column elementor-element elementor-element-b579d77\" data-eae-slider=\"33036\" data-id=\"b579d77\" data-element_type=\"column\" data-e-type=\"column\">\n\t\t\t<div class=\"elementor-widget-wrap elementor-element-populated\">\n\t\t\t\t\t\t<div class=\"elementor-element elementor-element-6a7f5f0 elementor-widget elementor-widget-text-editor\" data-id=\"6a7f5f0\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t<p data-start=\"152\" data-end=\"423\">We are excited to announce that <strong data-start=\"184\" data-end=\"271\">Gulf Oasis Travels & Tourism will once again be attending the Arabian Travel Market (ATM) this year<\/strong> \u2708\ufe0f. This prestigious event provides an excellent platform to connect with industry leaders, travel professionals, and innovators from across the globe.<\/p><p data-start=\"425\" data-end=\"788\">Arabian Travel Market is always a source of inspiration for us, offering valuable insights into emerging trends, new destinations, and the latest developments shaping the travel and tourism industry. At <strong data-start=\"628\" data-end=\"644\">Gulf Oasis Travels & Tourism<\/strong>, we continuously strive to enhance our services, build strong partnerships, and stay ahead by embracing innovation and industry best practices.<\/p><p data-start=\"790\" data-end=\"1012\">We look forward to engaging in meaningful conversations, strengthening existing relationships, and exploring new collaboration opportunities that help us create exceptional and memorable travel experiences for our clients.<\/p><p data-start=\"1014\" data-end=\"1086\"><strong data-start=\"1014\" data-end=\"1086\">Let\u2019s connect, collaborate, and shape the future of travel together.<\/strong><\/p>\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/section>\n\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t<div class=\"has_eae_slider elementor-column elementor-col-50 elementor-top-column elementor-element elementor-element-0bf9447\" data-eae-slider=\"83054\" data-id=\"0bf9447\" data-element_type=\"column\" data-e-type=\"column\">\n\t\t\t<div class=\"elementor-widget-wrap elementor-element-populated\">\n\t\t\t\t\t\t<div class=\"elementor-element elementor-element-7dacbdc elementor-widget elementor-widget-image\" data-id=\"7dacbdc\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"image.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<img fetchpriority=\"high\" decoding=\"async\" width=\"600\" height=\"503\" src=\"https:\/\/gulfoasistravelsandtourism.com\/wp-content\/uploads\/2025\/12\/486186236_1083356807156068_569628171668007087_n-1.jpg\" class=\"attachment-large size-large wp-image-9144\" alt=\"\" \/>\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/section>\n\t\t\t\t<section class=\"has_eae_slider elementor-section elementor-top-section elementor-element elementor-element-bf5913e elementor-section-boxed elementor-section-height-default elementor-section-height-default row-top\" data-eae-slider=\"47942\" data-id=\"bf5913e\" data-element_type=\"section\" data-e-type=\"section\">\n\t\t\t\t\t\t<div class=\"elementor-container elementor-column-gap-default\">\n\t\t\t\t\t<div class=\"has_eae_slider elementor-column elementor-col-100 elementor-top-column elementor-element elementor-element-32a04de\" data-eae-slider=\"93870\" data-id=\"32a04de\" data-element_type=\"column\" data-e-type=\"column\">\n\t\t\t<div class=\"e