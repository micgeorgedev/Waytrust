99\" data-id=\"d8e3c9f\" data-element_type=\"column\" data-e-type=\"column\">\n\t\t\t<div class=\"elementor-widget-wrap elementor-element-populated\">\n\t\t\t\t\t\t<div class=\"elementor-element elementor-element-cec0de9 elementor-widget__width-initial elementor-widget elementor-widget-gva-heading-block\" data-id=\"cec0de9\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"gva-heading-block.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<div class=\"gva-element-gva-heading-block gva-element\">   <div class=\"align-left style-1 widget gsc-heading box-align-left auto-responsive\">\r\n      <div class=\"content-inner\">\r\n         \r\n                  \r\n           \r\n         \r\n                     <h2 class=\"title\">\r\n               <span><span style=\"letter-spacing: -0.2px;\">Details<\/span><\/span>\r\n            <\/h2>\r\n                  \r\n         \r\n      <\/div>\r\n   <\/div>\r\n<\/div>\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<section class=\"has_eae_slider elementor-section elementor-inner-section elementor-element elementor-element-45160c1 elementor-section-boxed elementor-section-height-default elementor-section-height-default row-top\" data-eae-slider=\"10394\" data-id=\"45160c1\" data-element_type=\"section\" data-e-type=\"section\">\n\t\t\t\t\t\t<div class=\"elementor-container elementor-column-gap-default\">\n\t\t\t\t\t<div class=\"has_eae_slider elementor-column elementor-col-100 elementor-inner-column elementor-element elementor-element-b579d77\" data-eae-slider=\"35218\" data-id=\"b579d77\" data-element_type=\"column\" data-e-type=\"column\">\n\t\t\t<div class=\"elementor-widget-wrap elementor-element-populated\">\n\t\t\t\t\t\t<div class=\"elementor-element elementor-element-6a7f5f0 elementor-widget elementor-widget-text-editor\" data-id=\"6a7f5f0\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t<p data-start=\"115\" data-end=\"423\">We at <strong data-start=\"121\" data-end=\"137\">Waytransit Travels & Tourism<\/strong> were thrilled to attend the <strong data-start=\"166\" data-end=\"216\">SB19 PAGTATAG! World Tour \u2013 Asia Live in Dubai<\/strong>, proudly sponsored by <strong data-start=\"239\" data-end=\"262\">Philippine Airlines<\/strong> \ud83c\uddf5\ud83c\udded\u2708\ufe0f. The event was nothing short of spectacular, showcasing the extraordinary talent, energy, and artistry of the globally acclaimed Filipino group <strong data-start=\"414\" data-end=\"422\">SB19<\/strong>.<\/p><p data-start=\"425\" data-end=\"720\">Witnessing SB19 perform live was a truly unforgettable experience, as they captivated the audience with their fresh sound, powerful stage presence, and unmatched performances \ud83c\udfa4\u2728. The concert was a remarkable celebration of Filipino creativity, passion, and excellence on an international stage.<\/p><p data-start=\"722\" data-end=\"1034\">As a leading travel agency, <strong data-start=\"750\" data-end=\"766\">Waytransit Travels & Tourism<\/strong> is proud to be associated with and support world-class events that bring cultures together and highlight Filipino excellence across the globe. We look forward to continuing our journey of connecting people through travel, entertainment, and unforgettable experiences.<\/p>\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/section>\n\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t<div class=\"has_eae_slider elementor-column elementor-col-50 elementor-top-column elementor-element elementor-element-0bf9447\" data-eae-slider=\"75499\" data-id=\"0bf9447\" data-element_type=\"column\" data-e-type=\"column\">\n\t\t\t<div class=\"elementor-widget-wrap elementor-element-populated\">\n\t\t\t\t\t\t<div class=\"elementor-element elementor-element-7dacbdc elementor-widget elementor-widget-image\" data-id=\"7dacbdc\" data-element